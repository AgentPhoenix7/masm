				; Print the unsigned byte in AX as decimal.
 00CB				PRINT_BYTE PROC NEAR
 00CB  50			    PUSH AX
 00CC  53			    PUSH BX
 00CD  51			    PUSH CX
 00CE  52			    PUSH DX
				
 00CF  33 C9			    XOR CX, CX
 00D1  BB 000A			    MOV BX, 10
				
