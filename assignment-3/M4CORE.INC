; Core game rules. All positions are word-sized linear offsets into MAZE.
; No DOS, video, keyboard, or networking calls in this module.

RANDOM PROC NEAR
    PUSH BX
    PUSH DX
    MOV AX,RNG_SEED
    MOV BX,25173
    MUL BX
    ADD AX,13849
    MOV RNG_SEED,AX
    POP DX
    POP BX
    RET
RANDOM ENDP

RESET_GAME PROC NEAR
    PUSH AX
    PUSH CX
    PUSH DI
    PUSH ES
    PUSH DS
    POP ES
    XOR AX,AX
    LEA DI,POSITIONS
    MOV CX,OFFSET DISTANCES-OFFSET POSITIONS
    REP STOSB
    MOV PRIORITY,0
    MOV WORD PTR ELAPSED_TENTHS,0
    MOV WORD PTR ELAPSED_TENTHS+2,0
    MOV WIN_MASK,0
    MOV WORD PTR BEST_SCORE,0FFFFH
    MOV WORD PTR BEST_SCORE+2,0FFFFH
    POP ES
    POP DI
    POP CX
    POP AX
    RET
RESET_GAME ENDP

; AX = root; BFS_LIMIT = maximum explored path distance. Walls are impassable.
BFS PROC NEAR
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    PUSH ES
    PUSH AX
    PUSH DS
    POP ES
    LEA DI,DISTANCES
    MOV AX,0FFFFH
    MOV CX,CELLS
    REP STOSW
    POP AX
    MOV BX,AX
    SHL BX,1
    MOV DISTANCES[BX],0
    MOV QUEUE,AX
    MOV BFS_HEAD,0
    MOV BFS_TAIL,2
BFS_NEXT:
    MOV BX,BFS_HEAD
    CMP BX,BFS_TAIL
    JAE BFS_DONE
    MOV SI,QUEUE[BX]
    ADD BFS_HEAD,2
    MOV BX,SI
    SHL BX,1
    MOV BP,DISTANCES[BX]
    CMP BP,BFS_LIMIT
    JAE BFS_NEXT
    INC BP
    XOR DI,DI
BFS_NEIGHBOR:
    MOV AX,SI
    ADD AX,DELTAS[DI]
    CMP AX,CELLS
    JAE BFS_SKIP
    MOV BX,AX
    CMP MAZE[BX],'#'
    JE BFS_SKIP
    SHL BX,1
    CMP DISTANCES[BX],0FFFFH
    JNE BFS_SKIP
    MOV DISTANCES[BX],BP
    MOV BX,BFS_TAIL
    MOV QUEUE[BX],AX
    ADD BFS_TAIL,2
BFS_SKIP:
    ADD DI,2
    CMP DI,8
    JB BFS_NEIGHBOR
    JMP BFS_NEXT
BFS_DONE:
    POP ES
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
BFS ENDP

; Generate up to 64 candidates; keep the best capacity, stop at eight.
GENERATE_MAZE PROC NEAR
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    PUSH BP
    PUSH ES
    PUSH DS
    POP ES
    MOV BEST_CAP,0
    MOV GEN_TRIES,64
GEN_CANDIDATE:
    CALL CARVE_MAZE
    CALL SELECT_STARTS
    MOV AL,CAPACITY
    CMP AL,BEST_CAP
    JBE GEN_NEXT
    MOV BEST_CAP,AL
    LEA SI,MAZE
    LEA DI,BEST_MAZE
    MOV CX,CELLS
    REP MOVSB
    LEA SI,EXIT_POS
    LEA DI,BEST_META
    MOV CX,7
    REP MOVSB
    LEA SI,STARTS
    MOV CX,16
    REP MOVSB
GEN_NEXT:
    CMP BEST_CAP,8
    JE GEN_RESTORE
    DEC GEN_TRIES
    JNZ GEN_CANDIDATE
GEN_RESTORE:
    LEA SI,BEST_MAZE
    LEA DI,MAZE
    MOV CX,CELLS
    REP MOVSB
    LEA SI,BEST_META
    LEA DI,EXIT_POS
    MOV CX,7
    REP MOVSB
    LEA DI,STARTS
    MOV CX,16
    REP MOVSB
    MOV AL,BEST_CAP
    MOV CAPACITY,AL
    POP ES
    POP BP
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
GENERATE_MAZE ENDP

CARVE_MAZE PROC NEAR
    LEA DI,MAZE
    MOV CX,CELLS
    MOV AL,'#'
    REP STOSB
    MOV MAZE[COLS+1],' '
    MOV QUEUE,COLS+1
    MOV DFS_TOP,2
DFS_CELL:
    CMP DFS_TOP,0
    JE DFS_LOOPS
    MOV BX,DFS_TOP
    MOV SI,QUEUE[BX-2]
    MOV DFS_CURRENT,SI
    CALL RANDOM
    ; High bits avoid the LCG's alternating low-bit direction pattern.
    MOV AL,AH
    AND AX,3
    SHL AX,1
    MOV DFS_DIRECTION,AX
    MOV DFS_TRIES,4
DFS_TRY:
    MOV BX,DFS_DIRECTION
    MOV AX,DELTAS[BX]
    SHL AX,1
    ADD AX,DFS_CURRENT
    CMP AX,CELLS
    JAE DFS_REJECT
    MOV DI,AX
    XOR DX,DX
    MOV BX,COLS
    DIV BX
    CMP AX,1
    JB DFS_REJECT
    CMP AX,ROWS-1
    JAE DFS_REJECT
    CMP DX,1
    JB DFS_REJECT
    CMP DX,COLS-1
    JAE DFS_REJECT
    CMP MAZE[DI],'#'
    JNE DFS_REJECT
    MOV MAZE[DI],' '
    MOV BX,DFS_CURRENT
    ADD BX,DI
    SHR BX,1
    MOV MAZE[BX],' '
    MOV BX,DFS_TOP
    MOV QUEUE[BX],DI
    ADD DFS_TOP,2
    JMP DFS_CELL
DFS_REJECT:
    ADD DFS_DIRECTION,2
    AND DFS_DIRECTION,7
    DEC DFS_TRIES
    JNZ DFS_TRY
    SUB DFS_TOP,2
    JMP DFS_CELL
DFS_LOOPS:
    ; Open selected separating walls, retaining connectivity and outer walls.
    MOV SI,COLS+1
LOOP_WALL:
    CMP MAZE[SI],'#'
    JNE LOOP_NEXT
    MOV AX,SI
    XOR DX,DX
    MOV BX,COLS
    DIV BX
    CMP DX,0
    JE LOOP_NEXT
    CMP DX,COLS-1
    JE LOOP_NEXT
    CALL RANDOM
    TEST AH,3
    JNZ LOOP_NEXT
    CMP MAZE[SI-1],' '
    JNE LOOP_VERTICAL
    CMP MAZE[SI+1],' '
    JE LOOP_OPEN
LOOP_VERTICAL:
    CMP MAZE[SI-COLS],' '
    JNE LOOP_NEXT
    CMP MAZE[SI+COLS],' '
    JNE LOOP_NEXT
LOOP_OPEN:
    MOV MAZE[SI],' '
LOOP_NEXT:
    INC SI
    CMP SI,(ROWS-1)*COLS
    JB LOOP_WALL
CHOOSE_EXIT:
    CALL RANDOM
    XOR DX,DX
    MOV BX,CELLS
    DIV BX
    MOV BX,DX
    CMP MAZE[BX],' '
    JNE CHOOSE_EXIT
    MOV EXIT_POS,BX
    MOV MAZE[BX],'E'
    RET
CARVE_MAZE ENDP

SELECT_STARTS PROC NEAR
    MOV BFS_LIMIT,0FFFFH
    MOV AX,EXIT_POS
    CALL BFS
    LEA DI,HISTOGRAM
    XOR AX,AX
    MOV CX,CELLS
    REP STOSW
    MOV FLOOR_COUNT,0
    XOR SI,SI
HIST_CELL:
    CMP MAZE[SI],'#'
    JE HIST_NEXT
    CMP SI,EXIT_POS
    JE HIST_NEXT
    INC FLOOR_COUNT
    MOV BX,SI
    SHL BX,1
    MOV AX,DISTANCES[BX]
    CMP AX,12
    JB HIST_NEXT
    CMP AX,CELLS
    JAE HIST_NEXT
    MOV BX,AX
    SHL BX,1
    INC HISTOGRAM[BX]
HIST_NEXT:
    INC SI
    CMP SI,CELLS
    JB HIST_CELL
    XOR BP,BP
    MOV COMMON_DISTANCE,12
    MOV SI,24
HIST_MAX:
    MOV AX,HISTOGRAM[SI]
    CMP AX,BP
    JB HIST_MAX_NEXT
    JA HIST_BETTER
    CALL RANDOM
    TEST AH,1
    JZ HIST_MAX_NEXT
HIST_BETTER:
    MOV BP,HISTOGRAM[SI]
    MOV AX,SI
    SHR AX,1
    MOV COMMON_DISTANCE,AX
HIST_MAX_NEXT:
    ADD SI,2
    CMP SI,CELLS*2
    JB HIST_MAX
    MOV AX,FLOOR_COUNT
    XOR DX,DX
    MOV BX,20
    DIV BX
    CMP AX,8
    JBE CAP_DENSITY
    MOV AX,8
CAP_DENSITY:
    CMP AX,BP
    JBE CAP_GROUP
    MOV AX,BP
CAP_GROUP:
    MOV CAPACITY,AL
    MOV RESERVOIR_COUNT,0
    XOR SI,SI
RESERVOIR_CELL:
    MOV BX,SI
    SHL BX,1
    MOV AX,DISTANCES[BX]
    CMP AX,COMMON_DISTANCE
    JNE RESERVOIR_NEXT
    INC RESERVOIR_COUNT
    MOV BX,RESERVOIR_COUNT
    CMP BX,8
    JBE RESERVOIR_FIRST
    CALL RANDOM
    XOR DX,DX
    DIV BX
    CMP DX,8
    JAE RESERVOIR_NEXT
    MOV BX,DX
    JMP RESERVOIR_SAVE
RESERVOIR_FIRST:
    DEC BX
RESERVOIR_SAVE:
    SHL BX,1
    MOV STARTS[BX],SI
RESERVOIR_NEXT:
    INC SI
    CMP SI,CELLS
    JB RESERVOIR_CELL
    ; Fisher-Yates shuffles the retained starts, including groups smaller than 8.
    XOR CX,CX
    MOV CL,CAPACITY
    CMP CX,2
    JB STARTS_DONE
SHUFFLE_START:
    CALL RANDOM
    XOR DX,DX
    DIV CX
    MOV BX,DX
    SHL BX,1
    MOV DI,CX
    DEC DI
    SHL DI,1
    MOV AX,STARTS[DI]
    XCHG AX,STARTS[BX]
    MOV STARTS[DI],AX
    LOOP SHUFFLE_START
STARTS_DONE:
    RET
SELECT_STARTS ENDP

BUILD_INTENTS PROC NEAR
    XOR SI,SI
INTENT_PLAYER:
    MOV BX,SI
    SHL BX,1
    MOV AX,POSITIONS[BX]
    MOV CANDIDATES[BX],AX
    MOV BLOCKED[SI],0
    CMP PLAYER_STATE[SI],1
    JNE INTENT_NEXT
    XOR DX,DX
    MOV DL,DIRECTIONS[SI]
    CMP DX,1
    JB INTENT_NEXT
    CMP DX,4
    JA INTENT_NEXT
    DEC DX
    SHL DX,1
    MOV DI,DX
    ADD AX,DELTAS[DI]
    CMP AX,CELLS
    JAE INTENT_NEXT
    MOV DI,AX
    CMP MAZE[DI],'#'
    JE INTENT_NEXT
    MOV CANDIDATES[BX],AX
INTENT_NEXT:
    INC SI
    CMP SI,8
    JB INTENT_PLAYER
    RET
BUILD_INTENTS ENDP

; SI,DI are player indices. Cancel proposals after each complete pair pass.
RESOLVE_MOVES PROC NEAR
    ; The first slot can be empty, or the cursor owner can have become DNF.
    ; Normalize before arbitration so its successor does not get two turns.
    XOR BX,BX
    MOV BL,PRIORITY
    CMP PLAYER_STATE[BX],1
    JE RESOLVE_INIT
    CALL ROTATE_PRIORITY
RESOLVE_INIT:
    PUSH ES
    PUSH DS
    POP ES
    LEA DI,PAIR_TOUCH
    XOR AX,AX
    MOV CX,32
    REP STOSW
    MOV RESOLVE_PASSES,8
RESOLVE_PASS:
    MOV PAIR_I,0
PAIR_OUTER:
    MOV AX,PAIR_I
    INC AX
    MOV PAIR_J,AX
PAIR_INNER:
    MOV SI,PAIR_I
    MOV DI,PAIR_J
    CALL CHECK_PAIR
    INC PAIR_J
    CMP PAIR_J,8
    JB PAIR_INNER
    INC PAIR_I
    CMP PAIR_I,7
    JB PAIR_OUTER
    XOR SI,SI
CANCEL_PLAYER:
    CMP BLOCKED[SI],0
    JE CANCEL_NEXT
    MOV BX,SI
    SHL BX,1
    MOV AX,POSITIONS[BX]
    MOV CANDIDATES[BX],AX
CANCEL_NEXT:
    INC SI
    CMP SI,8
    JB CANCEL_PLAYER
    DEC RESOLVE_PASSES
    JNZ RESOLVE_PASS
    XOR SI,SI
CHARGE_OUTER:
    MOV DI,SI
    INC DI
CHARGE_INNER:
    MOV BX,SI
    MOV CL,3
    SHL BX,CL
    ADD BX,DI
    MOV AL,PAIR_TOUCH[BX]
    CMP COLLISION_MODE,0
    JNE SAVE_LATCH
    CMP AL,0
    JE SAVE_LATCH
    CMP PAIR_LATCH[BX],0
    JNE SAVE_LATCH
    PUSH BX
    MOV BX,SI
    SHL BX,1
    SHL BX,1
    ADD WORD PTR PENALTIES[BX],30
    ADC WORD PTR PENALTIES[BX+2],0
    MOV BX,DI
    SHL BX,1
    SHL BX,1
    ADD WORD PTR PENALTIES[BX],30
    ADC WORD PTR PENALTIES[BX+2],0
    POP BX
SAVE_LATCH:
    MOV PAIR_LATCH[BX],AL
    INC DI
    CMP DI,8
    JB CHARGE_INNER
    INC SI
    CMP SI,7
    JB CHARGE_OUTER
    POP ES
    RET
RESOLVE_MOVES ENDP

CHECK_PAIR PROC NEAR
    CMP PLAYER_STATE[SI],1
    JNE PAIR_DONE
    CMP PLAYER_STATE[DI],1
    JNE PAIR_DONE
    MOV BX,SI
    SHL BX,1
    MOV BP,DI
    SHL BP,1
    MOV AX,CANDIDATES[BX]
    MOV DX,DS:CANDIDATES[BP]
    CMP AX,POSITIONS[BX]
    JNE PAIR_ACTIVE
    CMP DX,DS:POSITIONS[BP]
    JE PAIR_DONE
PAIR_ACTIVE:
    CMP AX,DX
    JNE PAIR_SWAP
    CMP AX,EXIT_POS
    JE PAIR_DONE
    CMP COLLISION_MODE,1
    JNE PAIR_BOTH
    CMP AX,POSITIONS[BX]
    JE PAIR_BOTH
    CMP DX,DS:POSITIONS[BP]
    JE PAIR_BOTH
    MOV AX,SI
    SUB AL,PRIORITY
    AND AX,7
    MOV DX,DI
    SUB DL,PRIORITY
    AND DX,7
    CMP AX,DX
    JB PAIR_LOSE_J
    MOV BLOCKED[SI],1
    JMP PAIR_CONTACT
PAIR_LOSE_J:
    MOV BLOCKED[DI],1
    JMP PAIR_CONTACT
PAIR_SWAP:
    CMP AX,DS:POSITIONS[BP]
    JNE PAIR_DONE
    CMP DX,POSITIONS[BX]
    JNE PAIR_DONE
PAIR_BOTH:
    MOV BLOCKED[SI],1
    MOV BLOCKED[DI],1
PAIR_CONTACT:
    MOV BX,SI
    MOV CL,3
    SHL BX,CL
    ADD BX,DI
    MOV PAIR_TOUCH[BX],1
PAIR_DONE:
    RET
CHECK_PAIR ENDP

COMMIT_MOVES PROC NEAR
    XOR SI,SI
COMMIT_PLAYER:
    CMP PLAYER_STATE[SI],1
    JNE COMMIT_NEXT
    MOV BX,SI
    SHL BX,1
    MOV AX,CANDIDATES[BX]
    CMP AX,POSITIONS[BX]
    JE COMMIT_NEXT
    MOV POSITIONS[BX],AX
    SHL BX,1
    ADD WORD PTR STEPS[BX],1
    ADC WORD PTR STEPS[BX+2],0
    CMP AX,EXIT_POS
    JNE COMMIT_NEXT
    MOV PLAYER_STATE[SI],2
    MOV AX,WORD PTR ELAPSED_TENTHS
    MOV WORD PTR FINISH_TIMES[BX],AX
    MOV AX,WORD PTR ELAPSED_TENTHS+2
    MOV WORD PTR FINISH_TIMES[BX+2],AX
COMMIT_NEXT:
    INC SI
    CMP SI,8
    JB COMMIT_PLAYER
    CALL ROTATE_PRIORITY
    RET
COMMIT_MOVES ENDP

ROTATE_PRIORITY PROC NEAR
    ; Rotate through racers, not all eight slots. Empty/finished/DNF slots
    ; otherwise bias a two-player contest 7:1. Bound the final-finisher scan.
    MOV CX,MAX_PLAYERS
PRIORITY_NEXT:
    INC PRIORITY
    AND PRIORITY,7
    XOR BX,BX
    MOV BL,PRIORITY
    CMP PLAYER_STATE[BX],1
    JE PRIORITY_DONE
    LOOP PRIORITY_NEXT
PRIORITY_DONE:
    RET
ROTATE_PRIORITY ENDP

UPDATE_WARNINGS PROC NEAR
    MOV BFS_LIMIT,4
    XOR SI,SI
WARNING_PLAYER:
    MOV WARNINGS[SI],0
    CMP PLAYER_STATE[SI],1
    JNE WARNING_NEXT
    MOV BX,SI
    SHL BX,1
    MOV AX,POSITIONS[BX]
    CALL BFS
    XOR DI,DI
WARNING_OTHER:
    CMP DI,SI
    JE WARNING_OTHER_NEXT
    CMP PLAYER_STATE[DI],1
    JNE WARNING_OTHER_NEXT
    MOV BX,DI
    SHL BX,1
    MOV BX,POSITIONS[BX]
    SHL BX,1
    MOV AX,DISTANCES[BX]
    CMP AX,4
    JA WARNING_OTHER_NEXT
    CMP WARNINGS[SI],2
    JE WARNING_OTHER_NEXT
    MOV WARNINGS[SI],1
    CMP AX,2
    JA WARNING_OTHER_NEXT
    MOV WARNINGS[SI],2
WARNING_OTHER_NEXT:
    INC DI
    CMP DI,8
    JB WARNING_OTHER
WARNING_NEXT:
    INC SI
    CMP SI,8
    JB WARNING_PLAYER
    RET
UPDATE_WARNINGS ENDP

; SI=player, DX:AX=finish/current elapsed plus penalty.
GET_SCORE PROC NEAR
    MOV BX,SI
    SHL BX,1
    SHL BX,1
    MOV AX,WORD PTR ELAPSED_TENTHS
    MOV DX,WORD PTR ELAPSED_TENTHS+2
    CMP PLAYER_STATE[SI],2
    JNE SCORE_PENALTY
    MOV AX,WORD PTR FINISH_TIMES[BX]
    MOV DX,WORD PTR FINISH_TIMES[BX+2]
SCORE_PENALTY:
    ADD AX,WORD PTR PENALTIES[BX]
    ADC DX,WORD PTR PENALTIES[BX+2]
    RET
GET_SCORE ENDP

FIND_WINNERS PROC NEAR
    MOV WIN_MASK,0
    MOV WORD PTR BEST_SCORE,0FFFFH
    MOV WORD PTR BEST_SCORE+2,0FFFFH
    XOR SI,SI
WIN_PLAYER:
    CMP PLAYER_STATE[SI],2
    JNE WIN_NEXT
    CALL GET_SCORE
    CMP DX,WORD PTR BEST_SCORE+2
    JB WIN_NEW
    JA WIN_NEXT
    CMP AX,WORD PTR BEST_SCORE
    JB WIN_NEW
    JA WIN_NEXT
    JMP WIN_ADD
WIN_NEW:
    MOV WORD PTR BEST_SCORE,AX
    MOV WORD PTR BEST_SCORE+2,DX
    MOV WIN_MASK,0
WIN_ADD:
    MOV CX,SI
    MOV AL,1
    SHL AL,CL
    OR WIN_MASK,AL
WIN_NEXT:
    INC SI
    CMP SI,8
    JB WIN_PLAYER
    RET
FIND_WINNERS ENDP
