 400A				DATASEG ENDS
				
 0000				CODESEG SEGMENT PARA PUBLIC 'CODE'
				    ASSUME CS:CODESEG, DS:DATASEG, SS:STACKSEG
				
 0000				START:
 0000  B8 ---- R		    MOV AX, DATASEG
 0003  8E D8			    MOV DS, AX
				
 0005  8D 16 0000 R		    LEA DX, TITLE_TEXT
 0009  E8 00ED R		    CALL PRINT_STRING
				
				    ; Read 10 decimal byte values into DS:3000H
				.
 000C  BF 3000			    MOV DI, 3000H
 000F  B9 000A			    MOV CX, 10
				
 0012				INPUT_LOOP:
 0012  8D 16 0020 R		    LEA DX, PROMPT_TEXT
 0016  E8 00ED R		    CALL PRINT_STRING
 0019  E8 0078 R		    CALL READ_BYTE
 001C  73 03			    JNC INPUT_OK
 001E  EB 44 90			    JMP BAD_INPUT
				
 0021				INPUT_OK:
 0021  88 05			    MOV [DI], AL
 0023  47			    INC DI
 0024  E8 00F2 R		    CALL PRINT_NEWLINE
 0027  E2 E9			    LOOP INPUT_LOOP
				
				    ; This is the main part required by the que
				stion.
 0029  BE 3000			    MOV SI, 3000H
 002C  BF 4000			    MOV DI, 4000H
 002F  B9 000A			    MOV CX, 10
				
 0032				TRANSFER_LOOP:
 0032  8A 04			    MOV AL, [SI]
 0034  B3 05			    MOV BL, 5
 0036  F6 E3			    MUL BL
 0038  05 000A			    ADD AX, 10
 003B  88 05			    MOV [DI], AL
				
 003D  46			    INC SI
 003E  47			    INC DI
 003F  E2 F1			    LOOP TRANSFER_LOOP
				
				    ; Print the bytes stored at DS:4000H.
 0041  8D 16 0037 R		    LEA DX, OUTPUT_TEXT
 0045  E8 00ED R		    CALL PRINT_STRING
 0048  BE 4000			    MOV SI, 4000H
 004B  B9 000A			    MOV CX, 10
				
