				; Read one decimal number from 0 through 255.
				; Return: AL = byte and CF = 0, or CF = 1 for i
				nvalid input.
 0078				READ_BYTE PROC NEAR
 0078  53			    PUSH BX
 0079  51			    PUSH CX
 007A  52			    PUSH DX
 007B  56			    PUSH SI
				
 007C  8D 16 0070 R		    LEA DX, INPUT_BUFFER
 0080  B4 0A			    MOV AH, 0AH
 0082  CD 21			    INT 21H
				
 0084  8A 0E 0071 R		    MOV CL, INPUT_BUFFER[1]
 0088  32 ED			    XOR CH, CH
 008A  E3 39			    JCXZ RB_INVALID
 008C  83 F9 03			    CMP CX, 3
 008F  77 34			    JA RB_INVALID
				
 0091  8D 36 0072 R		    LEA SI, INPUT_BUFFER[2]
 0095  33 DB			    XOR BX, BX
				
 0097				RB_NEXT_DIGIT:
 0097  8A 04			    MOV AL, [SI]
 0099  3C 30			    CMP AL, '0'
 009B  72 28			    JB RB_INVALID
 009D  3C 39			    CMP AL, '9'
 009F  77 24			    JA RB_INVALID
				
