; MASM owns COM1 framing, admissions, sessions, input leases and race clocks.
; Serial wire: ':' + uppercase hex(payload, XOR checksum) + LF.
; All words/dwords are little endian. See phone/protocol.py and README.md.
.DATA
PHASE DB 1                       ; 1 lobby, 2 race, 3 results
EPOCH DW 1
GENERATION DW 1
PLAYER_COUNT DB 0
READY DB 8 DUP(0)
OWNER_IDS DW 8 DUP(0)
PLAYER_NAMES DB 64 DUP(32)
LAST_SEEN DW 8 DUP(0)
LAST_DIRECTION DW 8 DUP(0)
LAST_SEQUENCE DW 8 DUP(0)
HAVE_SEQUENCE DB 8 DUP(0)
HELD DB 8 DUP(0)
TAPS DB 8 DUP(0)
ROOM_CODE DB '------------',0
SYSTEM_TICK DW 0
LAST_BIOS DD 0
ELAPSED_TICKS DD 0
FRAME_TICKS DW 0
STATE_TICK DW 0FFFFH
RX_BUFFER DB 96 DUP(0)
RX_SIZE DW 0
RX_ACTIVE DB 0
RX_HALF DB 0
RX_HIGH DB 0
RX_CHECK DB 0
TX_BUFFER DB 2048 DUP(0)
TX_HEAD DW 0
TX_TAIL DW 0
TX_CHECK DB 0
OUT_BUFFER DB 256 DUP(0)
OUT_SIZE DW 0
ACK_CODE DB 0
ACK_SLOT DB 0FFH
SER_BUDGET DW 0
TEMP_SEQ DW 0
BACKUP_MAP DB CELLS DUP(0)
BACKUP_META DB 23 DUP(0)
.CODE
SERIAL_INIT PROC NEAR
    ; UART: 115200, 8N1, interrupts off; polled by the main loop.
    MOV DX,3F9H
    XOR AL,AL
    OUT DX,AL
    MOV DX,3FBH
    MOV AL,80H
    OUT DX,AL
    MOV DX,3F8H
    MOV AL,1
    OUT DX,AL
    INC DX
    XOR AL,AL
    OUT DX,AL
    MOV DX,3FBH
    MOV AL,3
    OUT DX,AL
    MOV DX,3FCH
    MOV AL,3
    OUT DX,AL
    RET
SERIAL_INIT ENDP

; Queue output without blocking game time. A snapshot is skipped if congested.
QUEUE_CHAR PROC NEAR
    PUSH BX
    MOV BX,TX_TAIL
    CMP BX,2048
    JAE QUEUE_FULL
    MOV TX_BUFFER[BX],AL
    INC TX_TAIL
QUEUE_FULL:
    POP BX
    RET
QUEUE_CHAR ENDP
HEX_NIBBLE PROC NEAR
    AND AL,0FH
    ADD AL,'0'
    CMP AL,'9'
    JBE HEX_CHAR
    ADD AL,7
HEX_CHAR:
    CALL QUEUE_CHAR
    RET
HEX_NIBBLE ENDP
HEX_BYTE PROC NEAR
    PUSH AX
    PUSH CX
    MOV AH,AL
    MOV CL,4
    SHR AL,CL
    CALL HEX_NIBBLE
    MOV AL,AH
    CALL HEX_NIBBLE
    POP CX
    POP AX
    RET
HEX_BYTE ENDP
SEND_PACKET PROC NEAR
    ; DS:SI payload, CX size. Caller guarantees 2*size+4 bytes of space.
    PUSH AX
    PUSH SI
    PUSH CX
    MOV AL,':'
    CALL QUEUE_CHAR
    MOV TX_CHECK,0
SEND_PACKET_BYTE:
    LODSB
    XOR TX_CHECK,AL
    CALL HEX_BYTE
    LOOP SEND_PACKET_BYTE
    MOV AL,TX_CHECK
    CALL HEX_BYTE
    MOV AL,10
    CALL QUEUE_CHAR
    POP CX
    POP SI
    POP AX
    RET
SEND_PACKET ENDP
SERIAL_FLUSH PROC NEAR
    MOV CX,512
FLUSH_NEXT:
    MOV BX,TX_HEAD
    CMP BX,TX_TAIL
    JAE FLUSH_EMPTY
    MOV DX,3FDH
    IN AL,DX
    TEST AL,20H
    JZ FLUSH_DONE
    MOV AL,TX_BUFFER[BX]
    MOV DX,3F8H
    OUT DX,AL
    INC TX_HEAD
    LOOP FLUSH_NEXT
    RET
FLUSH_EMPTY:
    MOV TX_HEAD,0
    MOV TX_TAIL,0
FLUSH_DONE:
    RET
SERIAL_FLUSH ENDP

; Returns a nibble in AL, carry on invalid ASCII hex.
PARSE_HEX PROC NEAR
    SUB AL,'0'
    CMP AL,9
    JBE PARSE_HEX_OK
    SUB AL,7
    CMP AL,10
    JB PARSE_HEX_BAD
    CMP AL,15
    JA PARSE_HEX_BAD
PARSE_HEX_OK:
    CLC
    RET
PARSE_HEX_BAD:
    STC
    RET
PARSE_HEX ENDP
SERIAL_POLL PROC NEAR
    MOV SER_BUDGET,256
POLL_BYTE:
    MOV DX,3FDH
    IN AL,DX
    TEST AL,1
    JZ POLL_DONE
    MOV DX,3F8H
    IN AL,DX
    CMP AL,':'
    JE POLL_START
    CMP RX_ACTIVE,0
    JE POLL_NEXT
    CMP AL,10
    JE POLL_END
    CALL PARSE_HEX
    JC POLL_INVALID
    CMP RX_HALF,0
    JNE POLL_LOW
    MOV CL,4
    SHL AL,CL
    MOV RX_HIGH,AL
    MOV RX_HALF,1
    JMP POLL_NEXT
POLL_LOW:
    OR AL,RX_HIGH
    MOV RX_HALF,0
    MOV BX,RX_SIZE
    CMP BX,96
    JAE POLL_INVALID
    MOV RX_BUFFER[BX],AL
    INC RX_SIZE
    XOR RX_CHECK,AL
    JMP POLL_NEXT
POLL_END:
    MOV RX_ACTIVE,0
    CMP RX_HALF,0
    JNE POLL_NEXT
    CMP RX_CHECK,0
    JNE POLL_NEXT
    CMP RX_SIZE,6
    JB POLL_NEXT
    DEC RX_SIZE                 ; discard checksum
    CALL RECEIVE_PACKET
    JMP POLL_NEXT
POLL_INVALID:
    MOV RX_ACTIVE,0
    JMP POLL_NEXT
POLL_START:
    MOV RX_ACTIVE,1
    MOV RX_SIZE,0
    MOV RX_HALF,0
    MOV RX_CHECK,0
POLL_NEXT:
    DEC SER_BUDGET
    JNZ POLL_BYTE
POLL_DONE:
    RET
SERIAL_POLL ENDP

SEND_ACK PROC NEAR
    CMP TX_TAIL,2028
    JA ACK_DONE
    MOV OUT_BUFFER,81H
    MOV AX,WORD PTR RX_BUFFER[1]
    MOV WORD PTR OUT_BUFFER[1],AX
    MOV AX,EPOCH
    MOV WORD PTR OUT_BUFFER[3],AX
    MOV AL,ACK_CODE
    MOV OUT_BUFFER[5],AL
    MOV AL,ACK_SLOT
    MOV OUT_BUFFER[6],AL
    LEA SI,OUT_BUFFER
    MOV CX,7
    CALL SEND_PACKET
ACK_DONE:
    RET
SEND_ACK ENDP

RECEIVE_PACKET PROC NEAR
    MOV ACK_CODE,3              ; invalid
    MOV ACK_SLOT,0FFH
    MOV AX,WORD PTR RX_BUFFER[3]
    CMP AX,EPOCH
    JE RECEIVE_EPOCH
    MOV ACK_CODE,4              ; stale room
    JMP RECEIVE_ACK
RECEIVE_EPOCH:
    CMP RX_BUFFER,1
    JE RECEIVE_CONFIG
    CMP RX_BUFFER,2
    JE RECEIVE_JOIN
    CMP RX_SIZE,8
    JB RECEIVE_ACK
    XOR SI,SI
    MOV AL,RX_BUFFER[5]
    CMP AL,8
    JAE RECEIVE_ACK
    MOV SI,AX                   ; clear upper byte below
    AND SI,00FFH
    MOV BX,SI
    SHL BX,1
    MOV AX,WORD PTR RX_BUFFER[6]
    CMP AX,0
    JE RECEIVE_ACK
    CMP AX,OWNER_IDS[BX]
    JNE RECEIVE_ACK
    CMP PLAYER_STATE[SI],0
    JE RECEIVE_ACK
    MOV AX,SYSTEM_TICK
    MOV LAST_SEEN[BX],AX
    MOV AX,SI
    MOV ACK_SLOT,AL
    JMP RECEIVE_OWNED
RECEIVE_CONFIG:
    CMP RX_SIZE,17
    JNE RECEIVE_ACK
    LEA SI,RX_BUFFER+5
    LEA DI,ROOM_CODE
    MOV CX,12
CONFIG_CHAR:
    LODSB
    CMP AL,'2'
    JB RECEIVE_ACK
    CMP AL,'Z'
    JA RECEIVE_ACK
    LOOP CONFIG_CHAR
    LEA SI,RX_BUFFER+5
    MOV CX,12
    REP MOVSB
    MOV ACK_CODE,0
    JMP RECEIVE_ACK
RECEIVE_JOIN:
    CMP RX_SIZE,13
    JNE RECEIVE_ACK
    MOV AX,WORD PTR RX_BUFFER[1]
    OR AX,AX
    JZ RECEIVE_ACK
    XOR SI,SI
JOIN_EXISTING:
    MOV BX,SI
    SHL BX,1
    CMP OWNER_IDS[BX],AX
    JE JOIN_ACCEPTED
    INC SI
    CMP SI,8
    JB JOIN_EXISTING
    CMP PHASE,1
    JE JOIN_PHASE_OK
    MOV ACK_CODE,1
    JMP RECEIVE_ACK
JOIN_PHASE_OK:
    MOV AL,PLAYER_COUNT
    CMP AL,CAPACITY
    JB JOIN_FIND
    MOV ACK_CODE,2
    JMP RECEIVE_ACK
JOIN_FIND:
    XOR SI,SI
JOIN_SLOT:
    CMP PLAYER_STATE[SI],0
    JE JOIN_CREATE
    INC SI
    CMP SI,8
    JB JOIN_SLOT
    JMP RECEIVE_ACK
JOIN_CREATE:
    ; Validate all name bytes before reserving a slot.
    LEA DI,RX_BUFFER+5
    MOV CX,8
JOIN_NAME_CHECK:
    MOV AL,[DI]
    CMP AL,32
    JB RECEIVE_ACK
    CMP AL,126
    JA RECEIVE_ACK
    INC DI
    LOOP JOIN_NAME_CHECK
    MOV BX,SI
    SHL BX,1
    MOV AX,WORD PTR RX_BUFFER[1]
    MOV OWNER_IDS[BX],AX
    MOV AX,STARTS[BX]
    MOV POSITIONS[BX],AX
    MOV AX,SYSTEM_TICK
    MOV LAST_SEEN[BX],AX
    MOV LAST_DIRECTION[BX],AX
    MOV PLAYER_STATE[SI],1
    MOV READY[SI],0
    MOV HAVE_SEQUENCE[SI],0
    MOV HELD[SI],0
    MOV TAPS[SI],0
    MOV DIRECTIONS[SI],0
    INC PLAYER_COUNT
    PUSH SI
    MOV DI,SI
    MOV CL,3
    SHL DI,CL
    ADD DI,OFFSET PLAYER_NAMES
    LEA SI,RX_BUFFER+5
    MOV CX,8
    REP MOVSB
    POP SI
JOIN_ACCEPTED:
    MOV AX,SI
    MOV ACK_SLOT,AL
    MOV ACK_CODE,0
    JMP RECEIVE_ACK
RECEIVE_OWNED:
    CMP RX_BUFFER,3
    JE RECEIVE_INPUT
    CMP RX_BUFFER,4
    JE RECEIVE_HEARTBEAT
    CMP RX_BUFFER,5
    JE RECEIVE_LEAVE
    CMP RX_BUFFER,6
    JE RECEIVE_READY
    JMP RECEIVE_ACK
RECEIVE_HEARTBEAT:
    CMP RX_SIZE,8
    JNE RECEIVE_ACK
    MOV ACK_CODE,0
    JMP RECEIVE_ACK
RECEIVE_LEAVE:
    CMP RX_SIZE,8
    JNE RECEIVE_ACK
    CALL DROP_PLAYER
    MOV ACK_CODE,0
    JMP RECEIVE_ACK
RECEIVE_READY:
    CMP PHASE,1
    JNE RECEIVE_ACK
    CMP RX_SIZE,9
    JNE RECEIVE_ACK
    MOV AL,RX_BUFFER[8]
    CMP AL,1
    JA RECEIVE_ACK
    MOV READY[SI],AL
    MOV ACK_CODE,0
    JMP RECEIVE_ACK
RECEIVE_INPUT:
    CMP RX_SIZE,14
    JNE RECEIVE_ACK
    CMP PHASE,2
    JNE RECEIVE_ACK
    CMP PLAYER_STATE[SI],1
    JNE RECEIVE_ACK
    MOV AX,WORD PTR RX_BUFFER[8]
    CMP AX,GENERATION
    JNE RECEIVE_ACK
    MOV AL,RX_BUFFER[12]
    CMP AL,4
    JA RECEIVE_ACK
    CMP BYTE PTR RX_BUFFER[13],1
    JA RECEIVE_ACK
    MOV AX,WORD PTR RX_BUFFER[10]
    CMP HAVE_SEQUENCE[SI],0
    JE INPUT_NEW
    MOV DX,AX
    SUB DX,LAST_SEQUENCE[BX]
    OR DX,DX                    ; modular signed delta, including 7fff->8000
    JLE RECEIVE_ACK
INPUT_NEW:
    MOV LAST_SEQUENCE[BX],AX
    MOV HAVE_SEQUENCE[SI],1
    MOV AX,SYSTEM_TICK
    MOV LAST_DIRECTION[BX],AX
    MOV AL,RX_BUFFER[12]
    MOV HELD[SI],AL
    CMP RX_BUFFER[13],0
    JE INPUT_NOT_TAP
    MOV TAPS[SI],AL
    MOV HELD[SI],0              ; first press is exactly one latched step
INPUT_NOT_TAP:
    MOV ACK_CODE,0
RECEIVE_ACK:
    CALL SEND_ACK
    RET
RECEIVE_PACKET ENDP

DROP_PLAYER PROC NEAR
    MOV HELD[SI],0
    MOV TAPS[SI],0
    MOV DIRECTIONS[SI],0
    MOV READY[SI],0
    MOV WARNINGS[SI],0
    CMP PHASE,1
    JNE DROP_DNF
    MOV PLAYER_STATE[SI],0
    MOV BX,SI
    SHL BX,1
    MOV OWNER_IDS[BX],0
    DEC PLAYER_COUNT
    RET
DROP_DNF:
    MOV BX,SI
    SHL BX,1
    MOV OWNER_IDS[BX],0
    CMP PLAYER_STATE[SI],1
    JNE DROP_DONE
    MOV PLAYER_STATE[SI],3
DROP_DONE:
    RET
DROP_PLAYER ENDP

; Snapshot is one frame: header plus eight complete records, no torn roster.
SEND_STATE PROC NEAR
    CMP TX_TAIL,1400
    JA STATE_DONE
    LEA DI,OUT_BUFFER
    MOV AL,82H
    STOSB
    MOV AX,EPOCH
    STOSW
    MOV AX,GENERATION
    STOSW
    MOV AL,PHASE
    STOSB
    MOV AL,CAPACITY
    STOSB
    MOV AL,COLLISION_MODE
    STOSB
    MOV AL,PLAYER_COUNT
    STOSB
    MOV AL,WIN_MASK
    STOSB
    MOV AX,EXIT_POS
    STOSW
    MOV AX,COMMON_DISTANCE
    STOSW
    MOV AX,FLOOR_COUNT
    STOSW
    MOV AX,WORD PTR ELAPSED_TENTHS
    STOSW
    MOV AX,WORD PTR ELAPSED_TENTHS+2
    STOSW
    MOV AX,WORD PTR BEST_SCORE
    STOSW
    MOV AX,WORD PTR BEST_SCORE+2
    STOSW
    XOR BP,BP
STATE_PLAYER:
    MOV SI,BP
    MOV AL,PLAYER_STATE[SI]
    STOSB
    MOV AL,WARNINGS[SI]
    STOSB
    MOV BX,SI
    SHL BX,1
    MOV AX,OWNER_IDS[BX]
    STOSW
    MOV AX,POSITIONS[BX]
    STOSW
    SHL BX,1
    MOV AX,WORD PTR STEPS[BX]
    STOSW
    MOV AX,WORD PTR STEPS[BX+2]
    STOSW
    MOV AX,WORD PTR PENALTIES[BX]
    STOSW
    MOV AX,WORD PTR PENALTIES[BX+2]
    STOSW
    MOV AX,WORD PTR FINISH_TIMES[BX]
    STOSW
    MOV AX,WORD PTR FINISH_TIMES[BX+2]
    STOSW
    MOV AL,READY[SI]
    STOSB
    MOV CL,3
    SHL SI,CL
    ADD SI,OFFSET PLAYER_NAMES
    MOV CX,8
    REP MOVSB
    INC BP
    CMP BP,8
    JB STATE_PLAYER
    MOV CX,DI
    SUB CX,OFFSET OUT_BUFFER
    LEA SI,OUT_BUFFER
    CALL SEND_PACKET
STATE_DONE:
    RET
SEND_STATE ENDP

READ_CLOCK PROC NEAR
    MOV AH,0
    INT 1AH
    MOV AX,DX
    MOV BX,CX
    SUB AX,WORD PTR LAST_BIOS
    SBB BX,WORD PTR LAST_BIOS+2
    JNC READ_CLOCK_OK
    ADD AX,00B0H
    ADC BX,0018H
READ_CLOCK_OK:
    MOV WORD PTR LAST_BIOS,DX
    MOV WORD PTR LAST_BIOS+2,CX
    ADD SYSTEM_TICK,AX
    ADD FRAME_TICKS,AX
    CMP PHASE,2
    JNE CLOCK_DONE
    ADD WORD PTR ELAPSED_TICKS,AX
    ADC WORD PTR ELAPSED_TICKS+2,BX
    MOV AX,WORD PTR ELAPSED_TICKS
    MOV DX,WORD PTR ELAPSED_TICKS+2
    CALL TICKS_TO_TENTHS
    MOV WORD PTR ELAPSED_TENTHS,AX
    MOV WORD PTR ELAPSED_TENTHS+2,DX
CLOCK_DONE:
    RET
READ_CLOCK ENDP
GAME_TICK PROC NEAR
    CMP FRAME_TICKS,2
    JB GAME_DONE
    MOV FRAME_TICKS,0
    XOR SI,SI
LEASE_PLAYER:
    CMP PLAYER_STATE[SI],1
    JNE LEASE_NEXT
    MOV BX,SI
    SHL BX,1
    CMP PHASE,2
    JNE LEASE_HELD
    MOV AX,SYSTEM_TICK
    SUB AX,LAST_SEEN[BX]
    CMP AX,546
    JB LEASE_HELD
    ; Timed-out players retain identity only to read their terminal DNF status.
    ; Explicit leave/host removal below revokes ownership immediately.
    MOV PLAYER_STATE[SI],3
    MOV HELD[SI],0
    MOV TAPS[SI],0
    MOV DIRECTIONS[SI],0
    MOV READY[SI],0
    MOV WARNINGS[SI],0
    JMP LEASE_NEXT
LEASE_HELD:
    MOV AX,SYSTEM_TICK
    SUB AX,LAST_DIRECTION[BX]
    CMP AX,14
    JB LEASE_FRESH
    MOV HELD[SI],0
    MOV TAPS[SI],0
LEASE_FRESH:
    MOV AL,HELD[SI]
    CMP TAPS[SI],0
    JE LEASE_SAVE
    MOV AL,TAPS[SI]
    MOV TAPS[SI],0
LEASE_SAVE:
    MOV DIRECTIONS[SI],AL
LEASE_NEXT:
    INC SI
    CMP SI,8
    JB LEASE_PLAYER
    CMP PHASE,2
    JNE GAME_DONE
    CALL BUILD_INTENTS
    CALL RESOLVE_MOVES
    CALL COMMIT_MOVES
    CALL UPDATE_WARNINGS
    XOR SI,SI
CHECK_REMAINING:
    CMP PLAYER_STATE[SI],1
    JE GAME_DONE
    INC SI
    CMP SI,8
    JB CHECK_REMAINING
    MOV PHASE,3
    CALL FIND_WINNERS
GAME_DONE:
    RET
GAME_TICK ENDP
START_RACE PROC NEAR
    CMP PHASE,1
    JNE START_DONE
    CMP PLAYER_COUNT,2
    JB START_DONE
    XOR SI,SI
START_CHECK:
    CMP PLAYER_STATE[SI],0
    JE START_NEXT
    CMP READY[SI],0
    JE START_DONE
START_NEXT:
    INC SI
    CMP SI,8
    JB START_CHECK
    MOV PHASE,2
    MOV WORD PTR ELAPSED_TICKS,0
    MOV WORD PTR ELAPSED_TICKS+2,0
    MOV WORD PTR ELAPSED_TENTHS,0
    MOV WORD PTR ELAPSED_TENTHS+2,0
    MOV FRAME_TICKS,0
START_DONE:
    RET
START_RACE ENDP
REGENERATE PROC NEAR
    CMP PHASE,1
    JNE REGENERATE_DONE
    LEA SI,MAZE
    LEA DI,BACKUP_MAP
    MOV CX,CELLS
    REP MOVSB
    LEA SI,EXIT_POS
    LEA DI,BACKUP_META
    MOV CX,23
    REP MOVSB
    CALL GENERATE_MAZE
    MOV AL,CAPACITY
    CMP AL,PLAYER_COUNT
    JAE REGENERATE_OK
    LEA SI,BACKUP_MAP
    LEA DI,MAZE
    MOV CX,CELLS
    REP MOVSB
    LEA SI,BACKUP_META
    LEA DI,EXIT_POS
    MOV CX,23
    REP MOVSB
    RET
REGENERATE_OK:
    INC GENERATION
    XOR SI,SI
REPOSITION:
    MOV BX,SI
    SHL BX,1
    MOV AX,STARTS[BX]
    MOV POSITIONS[BX],AX
    MOV READY[SI],0
    MOV HELD[SI],0
    MOV TAPS[SI],0
    INC SI
    CMP SI,8
    JB REPOSITION
REGENERATE_DONE:
    RET
REGENERATE ENDP
NEW_ROOM PROC NEAR
    CMP PHASE,2
    JE NEW_ROOM_DONE
    CALL RESET_GAME
    INC EPOCH
    JNZ EPOCH_OK
    INC EPOCH
EPOCH_OK:
    INC GENERATION
    MOV PHASE,1
    MOV PLAYER_COUNT,0
    LEA DI,READY
    MOV CX,8
    XOR AX,AX
    REP STOSB
    LEA DI,OWNER_IDS
    MOV CX,8
    REP STOSW
    LEA DI,PLAYER_NAMES
    MOV AL,32
    MOV CX,64
    REP STOSB
    LEA DI,ROOM_CODE
    MOV AL,'-'
    MOV CX,12
    REP STOSB
    CALL GENERATE_MAZE
NEW_ROOM_DONE:
    RET
NEW_ROOM ENDP

DIVIDE_U32 PROC NEAR
    PUSH SI
    PUSH DI
    MOV SI,AX
    MOV AX,DX
    XOR DX,DX
    DIV BX
    MOV DI,AX
    MOV AX,SI
    DIV BX
    MOV CX,DX
    MOV DX,DI
    POP DI
    POP SI
    RET
DIVIDE_U32 ENDP

; Convert BIOS ticks to tenths with the 18.2 Hz approximation.
; Predivision avoids overflowing 32 bits when multiplying by 100.
TICKS_TO_TENTHS PROC NEAR
    PUSH BX
    PUSH CX
    PUSH SI
    PUSH DI
    PUSH BP
    MOV BX,182
    CALL DIVIDE_U32
    PUSH CX
    MOV SI,DX
    MOV BX,100
    MUL BX
    MOV DI,AX
    MOV BP,DX
    MOV AX,SI
    MUL BX
    ADD AX,BP
    MOV DX,AX
    MOV AX,DI
    POP CX
    PUSH AX
    PUSH DX
    MOV AX,CX
    MUL BX
    MOV BX,182
    DIV BX
    MOV BX,AX
    POP DX
    POP AX
    ADD AX,BX
    ADC DX,0
    POP BP
    POP DI
    POP SI
    POP CX
    POP BX
    RET
TICKS_TO_TENTHS ENDP
