IF ERRORLEVEL 1 GOTO FAILED
LINK Q1.OBJ;
IF ERRORLEVEL 1 GOTO FAILED

ECHO Building Q2...
MASM Q2.ASM;
IF ERRORLEVEL 1 GOTO FAILED
LINK Q2.OBJ;
IF ERRORLEVEL 1 GOTO FAILED

ECHO Building Q3...
MASM Q3.ASM;
IF ERRORLEVEL 1 GOTO FAILED
LINK Q3.OBJ;
IF ERRORLEVEL 1 GOTO FAILED

ECHO Building Q4...
MASM Q4.ASM;
IF ERRORLEVEL 1 GOTO FAILED
LINK Q4.OBJ;
IF ERRORLEVEL 1 GOTO FAILED

ECHO Building STRLIB...
MASM STRLIB.ASM;
IF ERRORLEVEL 1 GOTO FAILED
IF EXIST STRLIB.LIB DEL STRLIB.LIB
ECHO Y>LIBYES.TXT
LIB STRLIB.LIB +STRLIB.OBJ; < LIBYES.TXT
IF ERRORLEVEL 1 GOTO FAILED
DEL LIBYES.TXT

ECHO Building Q5DEMO against STRLIB.LIB...
MASM Q5DEMO.ASM;
IF ERRORLEVEL 1 GOTO FAILED
LINK Q5DEMO.OBJ,Q5DEMO.EXE,,STRLIB.LIB;
IF ERRORLEVEL 1 GOTO FAILED

ECHO ALL FIVE QUESTIONS BUILT SUCCESSFULLY.
GOTO END

:FAILED
ECHO BUILD FAILED.

:END

